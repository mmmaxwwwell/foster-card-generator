{
  "name": "foster-card-generator",
  "version": "3.0.4",
  "main": "main.js",
  "homepage": "https://github.com/mmmaxwwwell/foster-card-generator",
  "author": {
    "name": "mmmaxwwwell",
    "email": "mmmaxwwwell@protonmail.com"
  },
  "scripts": {
    "generate-cards": "mkdir -p output && node src/generate-cards.js",
    "db:migrate": "node db/migrate.js",
    "db:reset": "node db/migrate.js --reset",
    "db:query": "sqlite3 db/animals.db",
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:linux": "electron-builder --linux --x64 --publish never",
    "vendor-assets": "node scripts/vendor-assets.js",
    "prestart": "node scripts/vendor-assets.js",
    "predev": "node scripts/vendor-assets.js",
    "prebuild": "node scripts/vendor-assets.js",
    "postinstall": "node scripts/vendor-assets.js && electron-builder install-app-deps",
    "test:scraper": "node test-scraper-integration.js",
    "test:scraper:local": "USE_LOCAL_FILE=true node test-scraper-integration.js",
    "test:scrape-adoptapet": "node test/scrape-url-adoptapet.test.js",
    "test:e2e": "node --test test/e2e/flows.spec.js"
  },
  "license": "MIT",
  "description": "Desktop app for creating printable foster animal business cards and flyers",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0",
    "codemirror": "^5.65.16",
    "handlebars": "^4.7.8",
    "htm": "^3.1.1",
    "js-yaml": "^4.1.0",
    "preact": "^10.19.3",
    "puppeteer": "^24.1.1",
    "qrcode": "^1.5.4",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "sql.js": "^1.11.0",
    "tmp": "^0.2.3",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.59.1",
    "selfsigned": "^5.5.0"
  },
  "build": {
    "appId": "com.foster-card-generator.app",
    "productName": "Foster Card Generator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "app/**/*",
      "src/**/*",
      "db/schema.sql",
      "db/migrate.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "docs/images/icon.png",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "docs/images/icon.png",
      "category": "Graphics"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
